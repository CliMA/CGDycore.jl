#!/bin/bash
# Moist Held-Suarez aquaplanet of Thatcher and Jablonowski (2016, GMD 9, 1263-1292): Held-Suarez
# temperature relaxation with T_equator = 294 K and (Delta T)_y = 65 K, Held-Suarez Rayleigh
# friction as the only momentum mixing (no surface drag, SurfaceFluxMom=false), bulk sensible and
# latent heat fluxes with C_H = C_E = 4.4e-3 and the K profile of Reed and Jablonowski (2012) for
# theta and q_v, large-scale condensation, SST of HeldSuarezMoistSurface. TJ16 spin up 6 months
# and average the following 30 months (30-day months). Reference (CAM5 SE, FV, EUL, SLD at 1 deg):
# global-mean precipitation 2.10-2.27 mm/day, equatorial 18.6-22.8 mm/day (TJ16 Table 3), jets
# about 65 m/s at 150 hPa near 30 deg, global-mean temperature 246.3-246.6 K.
# 1000 days, zonal means every 6 h from day 200 (<vtkFileName>_zonal.bin/.txt).
# Initial state of TJ16 Appendix A (balanced Ullrich et al. 2014 state, T as virtual
# temperature, humidity Eq. A1); before 2026-11-28 the runs started dry and at rest from a
# constant-N profile with 64 K at the model top.
# Large-scale condensation: saturation adjustment after every step, all condensate falls out at
# once (CGSEM.Condensation). Until 2026-11-27 the fall-out added theta * (condensed mass) to
# rho theta, 10-13 % of the latent heat too much; the heating of the phase change was right.
# From the dry start, dtau = 150 with HyperD 5e14 blew up after 9 days in grid-scale equatorial
# convection (stable without condensation); dtau = 100 with the CAM-SE ne30 values (1e15, div
# 2.5e15) ran 90 days: zonal jets 56-60 m/s at 25 deg and 200 hPa, P 2.33 mm/day, equatorial P
# 16.8 mm/day (days 30-90). --CondRelaxTime 300 and 900 s were as stable, zonal-mean RH stayed
# below 100 % (the large pointwise RH was in the very cold upper levels of the dry start).
# The explicit relaxation (SimpleMicrophysicsPot, Rain=1) was unstable with RelCloud = 3.3e-3
# (lambda dt = 2.1 with the latent heat feedback).
julia --project Examples/DriverCG.jl \
  --Problem="HeldSuarezMoistSphere" \
  --NumberThreadGPU=256 \
  --FloatTypeBackend="Float64" \
  --NumV=5 \
  --NumTr=2 \
  --TkePos=0 \
  --RhoVPos=6 \
  --RhoCPos=7 \
  --ModelType="VectorInvariant" \
  --Coriolis=true \
  --Upwind=true \
  --HorLimit=true \
  --HorLimitType="CAAS" \
  --Equation="CompressibleShallow" \
  --State="Moist" \
  --Microphysics=true \
  --TypeMicrophysics="Adjustment" \
  --Sedimentation=false \
  --Buoyancy=true \
  --Damping=true \
  --StrideDamp=10000 \
  --Relax=1.0e-3 \
  --Forcing=true \
  --pAuxPos=1 \
  --SurfaceFlux=true \
  --SurfaceFluxMom=false \
  --VerticalDiffusionMom=false \
  --JacVerticalDiffusion=true \
  --VerticalDiffusion=true \
  --Turbulence=false \
  --SurfaceScheme="Bulk" \
  --BulkCE=4.4e-3 \
  --Decomp="EqualArea" \
  --SimSeconds=0 \
  --SimDays=1000 \
  --PrintSeconds=0 \
  --PrintMinutes=0 \
  --PrintHours=0 \
  --PrintDays=10 \
  --StartAverageDays=200 \
  --ZonalMeanHours=6 \
  --Flat=true \
  --OrdPrint=2 \
  --OutputType="ADIOS2" \
  --vtkFileName="output/VTK/TJ16/CG32Quad" \
  --dtau=100 \
  --IntMethod="Rosenbrock" \
  --Table="SSP-Knoth" \
  --TopoS="" \
  --Stretch=true \
  --StretchType="Exp" \
  --GridType="CubedSphere" \
  --nz=64 \
  --nPanel=32 \
  --H=30000.0 \
  --OrdPoly=3 \
  --HyperVisc=true \
  --HyperDCurl=1.e15 \
  --HyperDGrad=1.e15 \
  --HyperDDiv=2.5e15 \
  --HyperDDivW=0.e15 \
  "$@"
