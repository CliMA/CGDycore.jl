#!/bin/bash
# DG baroclinic wave with BaroWaveHill orography on the cubed sphere, Conservative form,
# volume flux KennedyGruberGrav, interface flux RiemannLMARS
# device: export JuliaDevice="GPU" JuliaGPU="CUDA" (or "Metal"), default CPU
julia --project Examples/DriverDG.jl \
  --Problem="BaroWaveHillDrySphere" \
  --FloatTypeBackend="Float64" \
  --NumberThreadGPU=128 \
  --NumberThreadTriGPU=16 \
  --NumV=5 \
  --NumTr=0 \
  --NumAux=2 \
  --pAuxPos=1 \
  --GPAuxPos=2 \
  --Equation="CompressibleShallow" \
  --ModelType="Conservative" \
  --State="Dry" \
  --Discretization="DG" \
  --FluxDG="KennedyGruberGrav" \
  --InterfaceFluxDG="RiemannLMARS" \
  --VelocityForm="Cartesian" \
  --MetricType="Double" \
  --Buoyancy=false \
  --Coriolis=true \
  --Damping=true \
  --StrideDamp=20000 \
  --Relax=1.0e-3 \
  --Forcing=false \
  --VerticalDiffusion=false \
  --Upwind=true \
  --HorLimit=false \
  --Decomp="EqualArea" \
  --SimDays=5 \
  --PrintHours=6 \
  --PrintDays=0 \
  --OrdPrint=4 \
  --OrdPrintZ=4 \
  --vtkFileName="output/VTK/BaroWaveHillDrySphere/DGQuad" \
  --StartAverageDays=100 \
  --Flat=true \
  --dtau=75 \
  --dtauSmall=5 \
  --IntMethod="Rosenbrock" \
  --Table="SSP-Knoth" \
  --TopoS="BaroWaveHill" \
  --AdaptGridType="Sleve" \
  --Stretch=false \
  --GridForm="Spherical" \
  --GridType="CubedSphere" \
  --nPanel=13 \
  --nz=13 \
  --H=31000.0 \
  --OrdPoly=4 \
  --OrdPolyZ=4
