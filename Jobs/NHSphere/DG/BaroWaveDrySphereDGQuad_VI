#!/bin/bash
# DG baroclinic wave on the cubed sphere, VectorInvariant form,
# volume flux VectorInvariant, interface flux RiemannVectorInvariant
# device: export JuliaDevice="GPU" JuliaGPU="CUDA" (or "Metal"), default CPU
julia --project Examples/DriverDG.jl \
  --Problem="BaroWaveDrySphere" \
  --FloatTypeBackend="Float64" \
  --NumberThreadGPU=128 \
  --NumberThreadTriGPU=16 \
  --NumV=5 \
  --NumTr=0 \
  --NumAux=4 \
  --pAuxPos=1 \
  --GPAuxPos=2 \
  --Equation="CompressibleDeep" \
  --ModelType="VectorInvariant" \
  --State="Dry" \
  --Discretization="DG" \
  --FluxDG="VectorInvariant" \
  --InterfaceFluxDG="RiemannVectorInvariant" \
  --VelocityForm="Cartesian" \
  --MetricType="Double" \
  --Buoyancy=false \
  --Coriolis=true \
  --Damping=false \
  --StrideDamp=20000 \
  --Relax=1.0e-3 \
  --Forcing=false \
  --VerticalDiffusion=false \
  --Upwind=true \
  --HorLimit=false \
  --Decomp="EqualArea" \
  --SimDays=10 \
  --PrintHours=0 \
  --PrintDays=1 \
  --OrdPrint=4 \
  --OrdPrintZ=4 \
  --vtkFileName="output/VTK/BaroWaveDrySphere/DGQuad_VI" \
  --StartAverageDays=100 \
  --Flat=true \
  --dtau=85 \
  --dtauSmall=5 \
  --IntMethod="Rosenbrock" \
  --Table="SSP-Knoth" \
  --TopoS="" \
  --AdaptGridType="Sleve" \
  --Stretch=false \
  --GridForm="Spherical" \
  --GridType="CubedSphere" \
  --nPanel=20 \
  --nz=13 \
  --H=30000.0 \
  --OrdPoly=4 \
  --OrdPolyZ=4
