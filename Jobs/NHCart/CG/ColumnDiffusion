  --Damping=false \
  --Upwind=true \
  --BoundaryWE="Period" \
  --BoundarySN="Period" \
  --BoundaryBT="" \
  --SimHours=1 \
  --dtau=60 \
  --IntMethod="Rosenbrock" \
  --Table="SSP-Knoth" \
  --TopoS="Flat" \
